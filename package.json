{
  "name": "seed-finder",
  "productName": "Seed Finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Find Minecraft Java Edition seeds by spawn, biomes and structures, with Overworld/Nether/End maps. Supports 1.0 to 26.3.",
  "author": "Contraption8or",
  "homepage": "https://github.com/Contraption8or/seed-finder",
  "repository": { "type": "git", "url": "https://github.com/Contraption8or/seed-finder.git" },
  "main": "electron/main.cjs",
  "scripts": {
    "app": "electron .",
    "web": "node server.js",
    "start": "electron .",
    "smoke": "node tools/smoke.mjs",
    "build:wasm": "sh build.sh",
    "dist": "electron-builder --win --publish never",
    "release": "node tools/release.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "build": {
    "appId": "io.github.contraption8or.seedfinder",
    "productName": "Seed Finder",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["electron/**", "web/**", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Seed-Finder-Setup-${version}.${ext}",
      "shortcutName": "Seed Finder"
    },
    "publish": [{ "provider": "github", "owner": "Contraption8or", "repo": "seed-finder", "releaseType": "release" }]
  }
}
